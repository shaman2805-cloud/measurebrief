# Copy to .env.local and restart Vite. Use public values from your Firebase Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Enable Firebase AI Logic with the Gemini Developer API for the same project.
# Register the app in App Check and provide the public reCAPTCHA Enterprise site key.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional: change the Gemini Developer API cloud model used by this project.
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

# Optional localhost development only. Registers a browser-generated token once you
# allowlist it in Firebase Console. Never put the token itself into this file.
VITE_FIREBASE_APPCHECK_DEBUG=false
